{
  "name": "@kidthales/picotol",
  "version": "0.5.0",
  "description": "Pure-CSS, ultra-minified semantic HTML framework inspired by Pico CSS and powered strictly by Paul Tol colour schemes.",
  "license": "MIT",
  "author": "kidthales",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/picotol.min.css",
  "style": "./dist/picotol.min.css",
  "unpkg": "./dist/picotol.min.css",
  "jsdelivr": "./dist/picotol.min.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kidthales/picotol.git"
  },
  "homepage": "https://github.com/kidthales/picotol#readme",
  "bugs": {
    "url": "https://github.com/kidthales/picotol/issues"
  },
  "keywords": [
    "css",
    "picotol",
    "semantic-css",
    "classless-css",
    "picocss",
    "paul-tol",
    "colorblind-safe",
    "wcag",
    "accessibility",
    "design-tokens"
  ],
  "files": [
    "dist/picotol*.css",
    "dist/sri.json",
    "dist/manifest.json",
    "src/",
    "data/tol-qualitative.json",
    "types/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "default": "./dist/picotol.min.css"
    },
    "./css": {
      "default": "./dist/picotol.css"
    },
    "./core": {
      "default": "./dist/picotol.core.min.css"
    },
    "./core/css": {
      "default": "./dist/picotol.core.css"
    },
    "./layer": {
      "default": "./dist/picotol.layer.min.css"
    },
    "./layer/css": {
      "default": "./dist/picotol.layer.css"
    },
    "./tokens": {
      "default": "./src/tokens.css"
    },
    "./palettes": {
      "default": "./src/palettes.css"
    },
    "./palette-data": {
      "types": "./types/palette-data.d.ts",
      "default": "./data/tol-qualitative.json"
    },
    "./sri": {
      "types": "./types/sri.d.ts",
      "default": "./dist/sri.json"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.2.0"
  },
  "scripts": {
    "sync:tokens": "node tools/sync-tokens.mjs",
    "sync:upstream": "node tools/sync-tokens.mjs --upstream",
    "package:assets": "node tools/package-assets.mjs",
    "build": "node tools/build.mjs",
    "lint": "node tools/lint.mjs",
    "check:workflows": "node tools/check-workflows.mjs",
    "check:budgets": "node tools/check-budgets.mjs",
    "check:types": "tsc -p tests/fixtures/tsc/tsconfig.bundler.json --noEmit && tsc -p tests/fixtures/tsc/tsconfig.node16.json --noEmit",
    "generate": "npm run sync:tokens && npm run build",
    "test": "npm run lint && npm run check:budgets && node --test",
    "ci:local": "pwsh -NoProfile -ExecutionPolicy Bypass ./scripts/ci-local.ps1"
  },
  "devDependencies": {
    "lightningcss": "^1.30.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
